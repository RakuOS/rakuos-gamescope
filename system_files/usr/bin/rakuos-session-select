#!/bin/bash

SESSION="$1"

case "$SESSION" in
    "steam"|"steam-now")
        pkexec /usr/libexec/os-session-switch steam
        qdbus-qt6 org.kde.Shutdown /Shutdown org.kde.Shutdown.logout
        pkexec /usr/libexec/os-restart-login
        ;;
    "plasma"|"plasma-now")
        pkexec /usr/libexec/os-session-switch plasma
        steam -shutdown
        # Stop the whole graphical session, not just gamescope: the user's
        # systemd keeps running across the relogin, and a graphical-session
        # .target left active from Game Mode lets Plasma's autostart apps
        # (After=graphical-session.target) start before KWin is up, so they
        # all fail with no Wayland display, and keeps services bound to it
        # (portals) on the dead gamescope display. This script runs inside
        # the gamescope session and is killed when it stops, so the rest
        # runs in its own transient unit.
        systemd-run --user --collect --quiet --unit="rakuos-to-plasma-$$" \
            /usr/bin/bash -c 'systemctl --user stop gamescope-session.target xdg-desktop-autostart.target graphical-session.target; pkexec /usr/libexec/os-restart-login'
        ;;
    "steam-persistent")
        sudo systemctl mask autologin-setup-plasma.service
        sudo systemctl unmask autologin-setup.service
        sudo systemctl enable --now autologin-setup.service
        echo "Steam Big Picture is persistent session now"
        ;;
    "plasma-persistent")
        sudo systemctl mask autologin-setup.service
        sudo systemctl unmask autologin-setup-plasma.service
        sudo systemctl enable --now autologin-setup-plasma.service
        echo "Plasma is persistent session now"
        ;;
esac
