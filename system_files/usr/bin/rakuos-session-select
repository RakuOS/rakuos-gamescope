#!/bin/bash
SESSION="$1"

case "$SESSION" in
    "plasma-now")
    	# TODO: implement shutdown for plasma
        sed -i 's/Session=.*/Session=plasma.desktop/' /etc/plasmalogin.conf.d/autologin.conf
        systemctl restart sddm
        ;;
    "steam-now")
    	steam -shutdown
        sed -i 's/Session=.*/Session=gamescope-session-steam.desktop/' /etc/plasmalogin.conf.d/autologin.conf
        systemctl restart sddm
        ;;
    "plasma")
        sed -i 's/Session=.*/Session=plasma.desktop/' /etc/plasmalogin.conf.d/autologin.conf
        echo "Plasma session set as default session"
        ;;
    "steam")
        sed -i 's/Session=.*/Session=gamescope-session-steam.desktop/' /etc/plasmalogin.conf.d/autologin.conf
        echo "Steam big picture set as default session"
        ;;
esac
