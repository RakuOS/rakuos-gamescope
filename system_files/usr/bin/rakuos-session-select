#!/bin/bash
SESSION="$1"

case "$SESSION" in
    "plasma-now")
        sed -i 's/Session=.*/Session=plasma.desktop/' /etc/sddm.conf.d/autologin.conf
        systemctl restart sddm
        ;;
    "steam-now")
        sed -i 's/Session=.*/Session=gamescope-session-steam.desktop/' /etc/sddm.conf.d/autologin.conf
        systemctl restart sddm
        ;;
    "plasma")
        sed -i 's/Session=.*/Session=plasma.desktop/' /etc/sddm.conf.d/autologin.conf
        ;;
    "steam")
        sed -i 's/Session=.*/Session=gamescope-session-steam.desktop/' /etc/sddm.conf.d/autologin.conf
        ;;
esac
