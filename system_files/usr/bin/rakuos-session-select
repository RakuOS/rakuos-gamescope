#!/bin/bash

SESSION="$1"

case "$SESSION" in
    "plasma-now")
        sudo /usr/libexec/os-session-switch plasma
        steam -shutdown
        systemctl --user stop gamescope-session.target
        ;;
    "steam-now")
        sudo /usr/libexec/os-session-switch steam
        qdbus-qt6 org.kde.Shutdown /Shutdown org.kde.Shutdown.logout
        ;;
esac
